# Una sola versión del sitio: https://llantahorroqro.com.mx (sin www).
# Evita contenido duplicado entre http/https y www/sin www.
RewriteEngine On

# /index.html → /  y  /carpeta/index.html → /carpeta/
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://llantahorroqro.com.mx/$1 [R=301,L]

# http → https y www → sin www (deja libre /.well-known para renovar el SSL)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://llantahorroqro.com.mx%{REQUEST_URI} [R=301,L]

# Caché del navegador: visitas repetidas cargan más rápido
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
